# Docker Compose
COMPOSE_PROJECT_NAME=event-agent
EVENT_AGENT_IMAGE=ghcr.io/pihpohpah/webscraper
# Для scripts/deploy.sh по умолчанию используется короткий Git SHA.
# EVENT_AGENT_TAG=latest
PULL_POLICY=always
HTTP_BIND=0.0.0.0
HTTP_PORT=8000
TZ=Asia/Vladivostok
MEMORY_LIMIT=2g
CPU_LIMIT=2.0
PIDS_LIMIT=256

# scripts/deploy.sh
BUILD_PLATFORM=linux/amd64
DEPLOY_HOST=server.example.com
DEPLOY_USER=deploy
DEPLOY_SSH_PORT=22
DEPLOY_PATH=/opt/event-agent
DEPLOY_HEALTH_TIMEOUT=60
