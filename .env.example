# Ключ и адрес API Kimi Code (подписка). Ключ создаётся в консоли
# https://www.kimi.com/code/console и показывается один раз.
# Хост: зарубежный — api.kimi.ai, китайский — api.kimi.com (ключ и хост должны совпадать).
# Внимание: путь /coding/v1 — не /v1, как у обычного OpenAI-совместимого API.
OPENAI_API_KEY=sk-kimi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://api.kimi.ai/coding/v1
